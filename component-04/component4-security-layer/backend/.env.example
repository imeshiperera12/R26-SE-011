# Server
PORT=3001
NODE_ENV=development
JWT_ACCESS_SECRET=replace-with-a-64-character-random-secret
JWT_REFRESH_SECRET=replace-with-a-different-64-character-random-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
API_RATE_LIMIT=300
AUTH_RATE_LIMIT=10

# Component 4 operational database. Never commit real credentials.
MONGODB_URI=mongodb+srv://DB_USERNAME:URL_ENCODED_PASSWORD@YOUR_CLUSTER.mongodb.net/ZKP_Login?retryWrites=true&w=majority

# Component 1 is the sole academic-data authority.
# Deployed Component 1 proof API. Override with localhost only when Component 1
# is intentionally running as part of the local stack.
ACADEMIC_DATA_BASE_URL=https://r26-se-011-production-6665.up.railway.app/proof
RPC_URL=http://127.0.0.1:8545
CONTRACT_ADDRESS=replace-with-deployed-component4-grade-verifier-address
REQUIRE_GRADE_ZKP=true

# Optional inputs for `npm run panel:smoke`. Use a currently finalized
# Component 1 claim; no academic test record is built into Component 4.
PANEL_CANDIDATE_ID=
PANEL_MODULE_CODE=
PANEL_VALID_GRADE=

# Optional formal verification credential. Keep the real key only in .env.
CERTORAKEY=replace-with-certora-api-key
